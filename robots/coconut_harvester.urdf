<?xml version="1.0"?>
<robot name="coconut_harvester">
  <link name="base_link"><inertial><mass value="180"/><inertia ixx="12" iyy="18" izz="22" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><box size="1.2 0.9 0.36"/></geometry></visual><collision><geometry><box size="1.2 0.9 0.36"/></geometry></collision></link>
  <link name="left_wheel"><inertial><mass value="12"/><inertia ixx="0.2" iyy="0.2" izz="0.2" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><cylinder radius="0.22" length="0.12"/></geometry></visual><collision><geometry><cylinder radius="0.22" length="0.12"/></geometry></collision></link>
  <link name="right_wheel"><inertial><mass value="12"/><inertia ixx="0.2" iyy="0.2" izz="0.2" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><cylinder radius="0.22" length="0.12"/></geometry></visual><collision><geometry><cylinder radius="0.22" length="0.12"/></geometry></collision></link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.48 0.22" rpy="1.5708 0 0"/><axis xyz="0 0 1"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.48 0.22" rpy="1.5708 0 0"/><axis xyz="0 0 1"/></joint>
  <link name="mast_base"><inertial><mass value="35"/><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><cylinder radius="0.18" length="0.45"/></geometry></visual><collision><geometry><cylinder radius="0.18" length="0.45"/></geometry></collision></link>
  <joint name="mast_base_joint" type="fixed"><parent link="base_link"/><child link="mast_base"/><origin xyz="0 0 0.55"/></joint>
  <link name="mast"><inertial><mass value="25"/><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><cylinder radius="0.12" length="2.4"/></geometry></visual><collision><geometry><cylinder radius="0.12" length="2.4"/></geometry></collision></link>
  <joint name="mast_lift_joint" type="prismatic"><parent link="mast_base"/><child link="mast"/><origin xyz="0 0 1.35"/><axis xyz="0 0 1"/><limit lower="0" upper="8" effort="4000" velocity="0.4"/></joint>
  <link name="arm_mount"><inertial><mass value="20"/><inertia ixx="0.8" iyy="0.8" izz="0.8" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><cylinder radius="0.2" length="0.25"/></geometry></visual><collision><geometry><cylinder radius="0.2" length="0.25"/></geometry></collision></link>
  <joint name="arm_mount_joint" type="fixed"><parent link="mast"/><child link="arm_mount"/><origin xyz="0 0 1.35"/></joint>
  <link name="upper_arm"><inertial><mass value="18"/><inertia ixx="0.6" iyy="0.6" izz="0.3" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0.45 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.09" length="0.9"/></geometry></visual><collision><origin xyz="0.45 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.09" length="0.9"/></geometry></collision></link>
  <joint name="joint_1" type="revolute"><parent link="arm_mount"/><child link="upper_arm"/><origin xyz="0 0 0.18"/><axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="500" velocity="1.2"/></joint>
  <link name="forearm"><inertial><mass value="14"/><inertia ixx="0.5" iyy="0.5" izz="0.2" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0.4 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.075" length="0.8"/></geometry></visual><collision><origin xyz="0.4 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.075" length="0.8"/></geometry></collision></link>
  <joint name="joint_2" type="revolute"><parent link="upper_arm"/><child link="forearm"/><origin xyz="0.9 0 0"/><axis xyz="0 1 0"/><limit lower="-2.6" upper="2.6" effort="400" velocity="1.2"/></joint>
  <link name="wrist_1"><inertial><mass value="7"/><inertia ixx="0.15" iyy="0.15" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><cylinder radius="0.06" length="0.2"/></geometry></visual><collision><geometry><cylinder radius="0.06" length="0.2"/></geometry></collision></link>
  <joint name="joint_3" type="revolute"><parent link="forearm"/><child link="wrist_1"/><origin xyz="0.8 0 0"/><axis xyz="0 1 0"/><limit lower="-2.8" upper="2.8" effort="250" velocity="1.5"/></joint>
  <link name="wrist_2"><inertial><mass value="5"/><inertia ixx="0.12" iyy="0.12" izz="0.08" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><cylinder radius="0.055" length="0.18"/></geometry></visual><collision><geometry><cylinder radius="0.055" length="0.18"/></geometry></collision></link>
  <joint name="joint_4" type="revolute"><parent link="wrist_1"/><child link="wrist_2"/><origin xyz="0 0 0.2"/><axis xyz="1 0 0"/><limit lower="-3.14" upper="3.14" effort="180" velocity="1.8"/></joint>
  <link name="tool_mount"><inertial><mass value="3"/><inertia ixx="0.05" iyy="0.05" izz="0.05" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><box size="0.18 0.14 0.12"/></geometry></visual><collision><geometry><box size="0.18 0.14 0.12"/></geometry></collision></link>
  <joint name="joint_5" type="revolute"><parent link="wrist_2"/><child link="tool_mount"/><origin xyz="0 0 0.18"/><axis xyz="0 1 0"/><limit lower="-2.4" upper="2.4" effort="120" velocity="2"/></joint>
  <link name="harvest_tool"><inertial><mass value="2"/><inertia ixx="0.03" iyy="0.03" izz="0.03" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><box size="0.35 0.18 0.12"/></geometry></visual><collision><geometry><box size="0.35 0.18 0.12"/></geometry></collision></link>
  <joint name="tool_joint" type="fixed"><parent link="tool_mount"/><child link="harvest_tool"/><origin xyz="0.2 0 0"/></joint>
  <link name="cutter_blade"><inertial><mass value="0.8"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><box size="0.22 0.025 0.06"/></geometry></visual><collision><geometry><box size="0.22 0.025 0.06"/></geometry></collision></link>
  <joint name="cutter_joint" type="prismatic"><parent link="harvest_tool"/><child link="cutter_blade"/><origin xyz="0.18 0 0"/><axis xyz="1 0 0"/><limit lower="0" upper="0.12" effort="250" velocity="0.2"/></joint>
</robot>
